---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable">
  <section class="mx-auto flex max-w-3xl flex-col items-start gap-4 px-6 py-32">
    <p class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">404</p>
    <h1 class="font-display text-ink text-3xl font-medium">Cette page n'existe pas, ou plus.</h1>
    <p class="text-ink-soft">Le lien est peut-être cassé, ou la page a bougé.</p>
    <a href="/" class="text-signal font-mono text-sm hover:underline">← Retour</a>
  </section>
</BaseLayout>
